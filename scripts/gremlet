#!/bin/bash
# gremlet: make your desktop Gremlets react from the terminal, scripts, git hooks or test runners.
#
#   gremlet pass | fail | done | dance | wave | sleep | wake | special | water | stretch
#   gremlet focus [minutes]      start a focus session (they doze, then dance when the break starts)
#   gremlet unfocus              stop the focus timer
#   gremlet hide | show          hide them (e.g. before you present) / bring them back  (same as ⌃⌥G)
#   gremlet say "text" [seconds] the Gremlet nearest your cursor pops up with a speech bubble (default 8 s)
#   gremlet hobby [shelf|floor|<platform>]  the Gremlet nearest your cursor starts a window-box garden now; platforms:
#                                plank stone leaf cloud mushroom branch swing basket carpet treehouse snail
#   gremlet pair                 pair with your phone (opens a QR code to scan)
#   gremlet send [name]          send a Gremlet through the portal to your phone
#   gremlet status               what's out and whether a focus timer is running
#   gremlet meteors | festival | lanterns   start a little grove moment now
#   gremlet ferry | merchant     call the sky ferry, or the traveling merchant
#   gremlet snapshot             save a picture of your village (Pictures/Gremlets) and copy it
#   gremlet wrapped [YYYY-MM]    the month with Claude Code as a poster (--sample to preview)
#   gremlet kite                 a free Gremlet flies a kite for a while
#   gremlet stairs | cart        build a block staircase up to a window / lay a minecart rail along a wide one
#   gremlet chest | expedition   hide a treasure chest somewhere high (someone goes to fetch it) / someone sets out for the highest point
#   gremlet season winter|spring|summer|autumn|auto   preview a season for ten minutes (trees, village, islands)
#   gremlet night on|off|auto    preview night (lanterns, fireflies, spirits) for ten minutes
#   gremlet timelapse [project]  stitch the daily village postcards into a video, or one tree's days into a GIF
#   gremlet forest               every project's tree on one hillside (Pictures/Gremlets), copied
#   gremlet recap [project]      the last Claude session as a card: tree before/after, numbers, minute strip (--sample to preview)
#   gremlet card [project]       save a card of a project's bonsai with its story (Pictures/Gremlets) and copy it
#   gremlet demo [seconds]       play a scripted Claude session on your front window and record it, plus a GIF (Movies/Gremlets)
#   gremlet grow [tasks]         count Claude tasks toward the grove by hand (default 1)
#   gremlet run <command...>     run a command, then pass/fail on its exit code (exit code is preserved)
#
# Talks to the Gremlets app on 127.0.0.1 only. Set GREMLETS_PORT if you changed the port.
PORT="${GREMLETS_PORT:-47920}"
URL="http://127.0.0.1:${PORT}"

call() {
  curl -s -m 2 -X "${2:-POST}" -H 'X-Gremlets: 1' "${URL}/$1" || { echo "gremlet: the Gremlets app isn't running" >&2; return 1; }
}

case "${1:-}" in
  pass|fail|done|dance|wave|sleep|wake|special|water|stretch) call "$1" >/dev/null ;;
  focus)   call "focus?minutes=${2:-25}" >/dev/null ;;
  unfocus) call unfocus >/dev/null ;;
  hide|show) call "$1" >/dev/null ;;
  say)
    [ -n "${2:-}" ] || { echo 'usage: gremlet say "text" [seconds]' >&2; exit 2; }
    curl -s -m 2 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "text=$2" --data-urlencode "seconds=${3:-8}" "${URL}/say" >/dev/null \
      || { echo "gremlet: the Gremlets app isn't running" >&2; exit 1; } ;;
  hobby)
    q="hobby?"
    for a in "${@:2}"; do
      case "$a" in
        shelf) q="${q}shelf=1&" ;; floor) q="${q}shelf=0&" ;;
        plank|stone|leaf|cloud|mushroom|branch|swing|basket|carpet|treehouse|snail) q="${q}style=$a&" ;;
      esac
    done
    call "$q" >/dev/null ;;
  pair)    call phone/pair && echo && open "http://127.0.0.1:${PORT}/pair" ;;
  send)    curl -s -m 2 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "name=${2:-}" "${URL}/phone/send"; echo ;;
  wish)    call wish >/dev/null && echo "✨" ;;   # shh
  status)  call status GET; echo ;;
  ferry|merchant) call "$1" >/dev/null ;;
  kite)    call kite; echo ;;
  stairs|cart|chest|expedition) call "$1"; echo ;;
  wrapped) if [ "${2:-}" = "--sample" ]; then curl -s -m 20 -X POST -H 'X-Gremlets: 1' "${URL}/wrapped?sample=1"; else curl -s -m 20 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "month=${2:-}" "${URL}/wrapped"; fi; echo ;;
  snapshot) call snapshot; echo; echo 'Caption idea: "My desktop village so far. Every building is a Claude Code session, every plant grew from a finished task."' ;;
  season)  call "season?name=${2:-auto}"; echo ;;
  night)   call "night?on=${2:-auto}"; echo ;;
  timelapse) curl -s -m 120 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "project=${2:-}" "${URL}/timelapse"; echo ;;
  recap)   if [ "${2:-}" = "--sample" ]; then curl -s -m 10 -X POST -H 'X-Gremlets: 1' "${URL}/recap?sample=1"; else curl -s -m 10 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "project=${2:-}" "${URL}/recap"; fi; echo ;;
  forest)  call forest; echo; echo 'Caption idea: "Every project I have worked on with Claude Code, as a tree. The big ones are the ones I kept coming back to."' ;;
  card)    curl -s -m 5 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "project=${2:-}" "${URL}/card"; echo
           echo 'Caption idea: "This bonsai is my project. A branch per Claude Code session, a leaf per file edit, a flower per task, fruit when the tests pass."' ;;
  demo)
    secs="${2:-42}"
    out="$(curl -s -m 2 -X POST -H 'X-Gremlets: 1' "${URL}/demo?seconds=${secs}&pid=$PPID")" || { echo "gremlet: the Gremlets app isn't running" >&2; exit 1; }
    region="$(printf '%s' "$out" | /usr/bin/python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("region",""))
except Exception: print("")')"
    [ -n "$region" ] || { echo "gremlet: $out" >&2; exit 1; }
    if [ "${3:-}" = "--no-record" ]; then echo "Playing a ${secs}s Claude session demo."; exit 0; fi
    mkdir -p "$HOME/Movies/Gremlets"
    f="$HOME/Movies/Gremlets/Claude session $(date '+%Y-%m-%d %H.%M').mov"
    echo "Recording ${secs}s of the front window to $f"
    screencapture -V "$secs" -R "$region" "$f" && echo "Saved: $f"
    gif="$(curl -s -m 120 -G -X POST -H 'X-Gremlets: 1' --data-urlencode "path=$f" "${URL}/gif" | /usr/bin/python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("path",""))
except Exception: print("")')"
    [ -n "$gif" ] && echo "GIF:   $gif" ;;
  meteors|festival|lanterns) call "event?kind=$1" >/dev/null ;;
  grow)    call "grove/feed?tasks=${2:-1}"; echo ;;
  run)
    shift
    [ $# -gt 0 ] || { echo "usage: gremlet run <command...>" >&2; exit 2; }
    "$@"; code=$?
    if [ $code -eq 0 ]; then call pass >/dev/null; else call fail >/dev/null; fi
    exit $code ;;
  ""|-h|--help|help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "gremlet: unknown action '$1' (try: gremlet help)" >&2; exit 2 ;;
esac
