#!/bin/bash
# Claude Code hook for the Gremlets "Claude buddy". While Claude works, a Gremlet goes to that Claude window and
# gardens, paints or builds; when Claude is done (or needs you) it tells you, naming the project.
#
# Add to ~/.claude/settings.json (one command for every event):
#   "hooks": {
#     "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }],
#     "Stop":             [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }],
#     "Notification":     [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }],
#     "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }],
#     "PostToolUse":      [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }],
#     "SubagentStop":     [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }],
#     "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/gremlet-claude-hook" }] }]
#
# PostToolUse sends only the tool's *name* (Edit, Read, Bash...), never its input or output: an edit places a block on
# the Gremlet's island, a subagent brings a tiny helper along.
#   }
#
# Never blocks or fails Claude: prints nothing (UserPromptSubmit output would reach Claude), makes one 1-second local
# request and always exits 0. Sends only the event, the session id, the project folder's name and a process id
# (used to find the window). Nothing leaves your Mac.
PORT="${GREMLETS_PORT:-47920}"
input="$(cat)"
query="$(printf '%s' "$input" | /usr/bin/python3 -c '
import json, os, sys, urllib.parse
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
name = d.get("hook_event_name", "")
event = {"UserPromptSubmit": "start", "Stop": "done", "Notification": "attention", "SessionEnd": "end",
         "PostToolUse": "tool", "PostToolUseFailure": "toolfail", "SubagentStop": "helperdone"}.get(name)
if not event:
    sys.exit(0)
q = {
    "event": event,
    "session": d.get("session_id", "default"),
    "project": os.path.basename((d.get("cwd") or "").rstrip("/")) or "Claude",
    "pid": sys.argv[1],
}
if event in ("tool", "toolfail"):
    q["tool"] = str(d.get("tool_name", ""))[:60]
    # Only a yes/no "was this a test run?", never the command itself (it drives the weather).
    cmd = str((d.get("tool_input") or {}).get("command", "")) if q["tool"] == "Bash" else ""
    import re
    if re.search(r"\b(test|tests|pytest|jest|vitest|mocha|rspec|go test|cargo test|swift test|xcodebuild test|npm t)\b", cmd):
        q["kind"] = "test"
if event == "attention":
    q["kind"] = "permission" if "permission" in (d.get("message") or "").lower() else "waiting"
print(urllib.parse.urlencode(q))
' "$PPID" 2>/dev/null)"
[ -n "$query" ] && curl -s -m 1 -X POST -H 'X-Gremlets: 1' "http://127.0.0.1:${PORT}/claude?${query}" >/dev/null 2>&1
exit 0
