#!/bin/bash
# Claude Code hook: a Gremlet tells you when Claude finishes or needs you, and in which project.
#
# Add to ~/.claude/settings.json (Stop = Claude finished its turn, Notification = it's waiting on you):
#   "hooks": {
#     "Stop":         [{ "hooks": [{ "type": "command", "command": "/path/to/gremlet-claude-hook" }] }],
#     "Notification": [{ "hooks": [{ "type": "command", "command": "/path/to/gremlet-claude-hook" }] }]
#   }
#
# Never blocks or fails Claude: it reads the hook's JSON, makes one 2-second local request, and always exits 0.
# Only the project folder's name goes into the bubble; nothing leaves your Mac.
DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
input="$(cat)"
msg="$(printf '%s' "$input" | /usr/bin/python3 -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
project = os.path.basename((d.get("cwd") or "").rstrip("/")) or "Claude"
event = d.get("hook_event_name", "")
if event == "Stop":
    print(f"{project}: Claude is done ✓")
elif event == "Notification":
    text = (d.get("message") or "").lower()
    if "permission" in text:
        print(f"{project}: Claude needs your OK")
    else:
        print(f"{project}: Claude is waiting for you")
' 2>/dev/null)"
[ -n "$msg" ] && "$DIR/gremlet" say "$msg" 10 >/dev/null 2>&1
exit 0
